!benchmark_runner/data/checkpoints/*.pt
!benchmark_runner/data/checkpoints/*.pth

# Raw CIFAR-10 dataset — auto-downloaded by torchvision, too big for GitHub
# (cifar-10-python.tar.gz is 163 MB > GitHub's 100 MB file limit)
benchmark_runner/data/cifar10/
